#N canvas 0 34 777 779 10;
#X obj 100 80 witmagic;
#X obj 100 200 route quat euler acclin speed mag;
#X text 297 142 Inlet: list [ax ay az gx gy gz] accel(g) gyro(°/s). Mag via "mag" message (µT from witsensor);
#X text 323 195 Messages: rate \, level \, magcal \, reset \, zzero \, fusiongain \, veldecay;
#X text 282 223 Outlet: [route quat euler acclin speed mag] to dispatch;
#X text 251 239 quat -- orientation (w x y z) sensor-to-world;
#X text 284 101 acclin -- linear accel (gravity subtracted) in g (list 3) \, ~0 when still;
#X text 248 261 speed -- integrated speed in mm/s (list 3);
#X text 253 283 mag x y z -- magnetometer (µT). magcal 1/0: collect min-max \, compute offset+scale;
#X text 253 311 level -- when flat (Z up) \, set accel offset so pitch/roll → 0;
#X text 245 340 fusiongain <float> -- sensor fusion gain (accel+mag correction) 0.001–1 (default 0.3);
#X text 254 401 veldecay <float> -- velocity decay per sample 0.5–0.9999 (default 0.99);
#X text 247 371 reset -- zero quat and speed. zzero -- current heading = 0;
#X text 242 437 rate <float> -- sample rate Hz (or connect witsensor status via [route rate]);
#X msg 99 123 level;
#X msg 155 125 fusiongain 0.3;
#X obj 125 541 witsensor;
#X connect 0 0 1 0;
