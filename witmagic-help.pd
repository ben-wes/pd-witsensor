#N canvas 0 0 450 420 10;
#X obj 100 80 witmagic;
#X obj 100 120 pack f f f f f f;
#X floatatom 100 145 8 0 0 0 - - - 0;
#X floatatom 125 145 8 0 0 0 - - - 0;
#X floatatom 150 145 8 0 0 0 - - - 0;
#X floatatom 175 145 8 0 0 0 - - - 0;
#X floatatom 200 145 8 0 0 0 - - - 0;
#X floatatom 225 145 8 0 0 0 - - - 0;
#X obj 100 200 route quat euler acclin speed mag;
#X text 80 50 witmagic;
#X text 80 170 Inlet: list [ax ay az gx gy gz] accel(g) gyro(°/s). Mag via "mag" message (µT from witsensor);
#X text 80 192 Messages: rate \, level \, magcal \, reset \, zzero \, fusiongain \, veldecay;
#X text 100 220 Outlet: [route quat euler acclin speed mag] to dispatch;
#X text 110 237 quat -- orientation (w x y z) sensor-to-world;
#X text 110 254 acclin -- linear accel (gravity subtracted) in g (list 3) \, ~0 when still;
#X text 110 271 speed -- integrated speed in mm/s (list 3);
#X text 80 288 mag x y z -- magnetometer (µT). magcal 1/0: collect min-max \, compute offset+scale;
#X text 80 305 level -- when flat (Z up) \, set accel offset so pitch/roll → 0;
#X text 80 321 fusiongain <float> -- sensor fusion gain (accel+mag correction) 0.001–1 (default 0.3);
#X text 80 338 veldecay <float> -- velocity decay per sample 0.5–0.9999 (default 0.99);
#X text 80 355 reset -- zero quat and speed. zzero -- current heading = 0;
#X text 80 372 rate <float> -- sample rate Hz (or connect witsensor status via [route rate]);
#X msg 100 400 level;
#X msg 125 400 fusiongain 0.3;
#X connect 1 0 0 0;
#X connect 2 0 1 0;
#X connect 3 0 1 1;
#X connect 4 0 1 2;
#X connect 5 0 1 3;
#X connect 6 0 1 4;
#X connect 7 0 1 5;
#X connect 0 0 8 0;
