#X text 170 38 - connect to WitMotion WT9011DCL-BT50 sensor via Bluetooth Low Energy (BLE), f 75;
#N canvas 462 293 449 170 creation 1;
#X text 21 63 -dejitter / -j: activate de-jittering;
#X text 21 81 -listmode / -l: output one list for all streamed data;
#X text 23 24 witsensor supports these creation flags:;
#X text 21 117 -nr: gyro (rad/s) and angle (rad) \, default is ° and °/s \;;
#X text 21 99 -n or -nc: gyro (turns/s) and angle (cycles) \, 1 = full rotation, f 63;
#X restore 417 333 pd creation args;
#X obj 44 412 r \$0-out;
